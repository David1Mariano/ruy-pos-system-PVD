                text = "[-]"; setBackgroundColor(red); setTextColor(white); setPadding(8, 4, 8, 4)
                setOnClickListener { val n = (cart[name] ?: 0) - 1; if (n <= 0) cart.remove(name) else cart[name] = n; showSales() }
                layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            }
