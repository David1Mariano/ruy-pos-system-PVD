    private fun registerOrder() {
        if (cart.isEmpty()) { Toast.makeText(this@MainActivity, "Carrinho vazio", Toast.LENGTH_SHORT).show(); return }

        val total = cart.fold(0) { acc, (name, qty) -> acc + (unitPrice[name] ?: 0) * qty }
        val items = cart.map { it.key to it.value }

        val orderJson = JSONObject().apply {
            put("id", UUID.randomUUID().toString())
            put("createdAt", System.currentTimeMillis())
            put("totalCents", total)
            put("paymentStatus", "UNPAID")
            put("syncStatus", "PENDING")
            val itemsArr = JSONArray()
            items.forEach { (name, qty) ->
                val item = JSONObject()
                item.put("name", name)
                item.put("qty", qty)
                item.put("unitCents", (unitPrice[name] ?: 0).toInt())
                itemsArr.put(item)
            }
            put("items", itemsArr)
        }

        val url = prefs.getString("sync_url", "") ?: ""
        val token = prefs.getString("device_token", "") ?: ""

        if (!url.startsWith("https://")) { Toast.makeText(this@MainActivity, "URL não configurada (HTTPS obrigatório)", Toast.LENGTH_LONG).show(); return }
        if (token.isBlank()) { Toast.makeText(this@MainActivity, "Token do terminal não configurado", Toast.LENGTH_LONG).show(); return }

        thread {
            val syncResult = SyncClient.send(url, token, orderJson)
            if (syncResult.isSuccess) {
                runOnUiThread { Toast.makeText(this@MainActivity, "Pedido confirmado no servidor", Toast.LENGTH_SHORT).show(); cart.clear(); showHome() }
            } else {
                val exception = syncResult.exceptionOrNull()
                val msg = exception?.message ?: "Erro desconhecido"
                runOnUiThread { Toast.makeText(this@MainActivity, if (msg.startsWith("409_CONFLICT")) "Conflito de idempotência" else "Falha ao enviar: $msg", Toast.LENGTH_LONG).show() }
            }
        }.start()
    }

    private fun showHistory() {
            total += unit * qty
            val row = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL; setPadding(4, 4, 4, 4) }
