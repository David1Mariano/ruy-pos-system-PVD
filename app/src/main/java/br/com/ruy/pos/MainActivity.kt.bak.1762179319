    private fun syncNow() {
        val url = prefs.getString("sync_url", "") ?: ""
        val token = prefs.getString("device_token", "") ?: ""
        if (!url.startsWith("https://")) { Toast.makeText(this@MainActivity, "URL não configurada (HTTPS obrigatório)", Toast.LENGTH_LONG).show(); return }
        if (token.isBlank()) { Toast.makeText(this@MainActivity, "Token do terminal não configurado", Toast.LENGTH_LONG).show(); return }
        Toast.makeText(this@MainActivity, "Sincronizando catálogo...", Toast.LENGTH_SHORT).show()
        val work = OneTimeWorkRequestBuilder<SyncWorker>().build()
        WorkManager.getInstance(this@MainActivity).enqueue(work)
        Handler(Looper.getMainLooper()).postDelayed({ Toast.makeText(this@MainActivity, "Sincronização agendada", Toast.LENGTH_SHORT).show() }, 800)
    }

    private fun loadCatalog() {
        thread {
            try {
                val url = prefs.getString("sync_url", "") ?: ""
                val token = prefs.getString("device_token", "") ?: ""
                if (!url.startsWith("https://") || token.isBlank()) return@thread

                val conn = URL("$url/api/catalog").openConnection() as HttpURLConnection
                conn.requestMethod = "GET"
                conn.connectTimeout = 15000
                conn.readTimeout = 15000
                conn.setRequestProperty("Authorization", "Bearer $token")
                val status = conn.responseCode
                if (status == 200) {
                    val reply = conn.inputStream.bufferedReader().use { it.readText() }
                    val arr = JSONArray(reply)
                    val list = mutableListOf<ProductEntity>()
                    val priceMap = mutableMapOf<String, Int>()
                    for (i in 0 until arr.length()) {
                        val it = arr.getJSONObject(i)
                        val product = ProductEntity(
                            id = it.optString("id", UUID.randomUUID().toString()),
                            sku = it.optString("sku", null),
                            name = it.optString("name", ""),
                            category = it.optString("category", null),
                            priceCents = it.optInt("price_cents", 0),
                            active = it.optBoolean("active", true),
                            imageUrl = it.optString("image_url", null),
                            version = it.optLong("version", 1),
                            updatedAt = it.optString("updated_at", null),
                            unit = it.optString("unit", null)
                        )
                        list.add(product)
                        priceMap[product.name] = product.priceCents
                    }
                    runOnUiThread {
                        products.clear()
                        products.addAll(list)
                        unitPrice.clear()
                        unitPrice.putAll(priceMap)
                        if (currentScreen == "sales") showSales()
                        Toast.makeText(this@MainActivity, "Catálogo: ${list.size} produtos", Toast.LENGTH_SHORT).show()
                    }
                } else {
                    runOnUiThread { Toast.makeText(this@MainActivity, "Falha catálogo: HTTP $status", Toast.LENGTH_SHORT).show() }
                }
                conn.disconnect()
            } catch (e: Exception) {
                runOnUiThread { Toast.makeText(this@MainActivity, "Falha ao carregar catálogo: ${e.message}", Toast.LENGTH_SHORT).show() }
            }
        }.start()
    }
}


